{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=../ShopiiDb.db"
  },
  "Jwt": {
    "Issuer": "Shopii.API",
    "Audience": "Shopii.Client",
    "AccessTokenMinutes": 15
  },
  "Audit": {
    "RetentionDays": 365
  },
  "RateLimiting": {
    "PermitLimit": 5,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "AllowedHosts": "*"
}
